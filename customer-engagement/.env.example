# Copy to .env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=            # Claude API key (AI copywriter)
GHL_TOKEN=                    # GoHighLevel Private Integration token (sub-account level)
GHL_LOCATION_ID=              # GoHighLevel sub-account / location id
WEBHOOK_TOKEN=                # random string; add ?token=<this> to GHL workflow webhook URLs
PHONE_MODE=task               # task = call task for a rep, ai = enrol in VOICE_WORKFLOW_ID
VOICE_WORKFLOW_ID=            # GHL workflow that places the Voice AI call (PHONE_MODE=ai)
EMAIL_FROM=                   # e.g. "Karan <karan@yourdomain.com>"
DRY_RUN=true                  # keep true until the plan is approved and tested
